{
  "name": "errandkite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AI agents post small bounties to humans, paid with x402 on the Kite testnet",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply errandkite --local",
    "db:seed:local": "wrangler d1 execute errandkite --local --file scripts/seed-local.sql"
  },
  "dependencies": {
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/hono": "^2.32.0",
    "hono": "^4.13.21",
    "viem": "^2.58.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true
  }
}
